{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:relationship-network:job-requirement-schema:v2",
  "title": "职位需求 Schema v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "hard_conditions",
    "preference_conditions",
    "research_topic_query",
    "unsupported_conditions",
    "source_conflicts"
  ],
  "properties": {
    "hard_conditions": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/executable_condition" }
    },
    "preference_conditions": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/executable_condition" }
    },
    "research_topic_query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "unsupported_conditions": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/unsupported_condition" }
    },
    "source_conflicts": {
      "type": "array",
      "maxItems": 50,
      "items": { "$ref": "#/$defs/source_conflict" }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "start_offset", "end_offset", "quote"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "start_offset": { "type": "integer", "minimum": 0 },
        "end_offset": { "type": "integer", "minimum": 1 },
        "quote": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "evidence_list": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "numeric_threshold_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "operator", "value", "description", "evidence"],
      "properties": {
        "field": {
          "enum": ["qs_top200_rank", "world_top500_rank", "h_index", "total_citations"]
        },
        "operator": { "enum": ["gte", "lte"] },
        "value": { "type": "number", "minimum": 0 },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "evidence": { "$ref": "#/$defs/evidence_list" }
      }
    },
    "numeric_between_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "operator", "value", "description", "evidence"],
      "properties": {
        "field": {
          "enum": ["qs_top200_rank", "world_top500_rank", "h_index", "total_citations"]
        },
        "operator": { "const": "between" },
        "value": {
          "type": "array",
          "prefixItems": [
            { "type": "number", "minimum": 0 },
            { "type": "number", "minimum": 0 }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "evidence": { "$ref": "#/$defs/evidence_list" }
      }
    },
    "chinese_identity_eq_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "operator", "value", "description", "evidence"],
      "properties": {
        "field": { "const": "chinese_identity" },
        "operator": { "const": "eq" },
        "value": { "enum": ["国内华人", "海外华人", "外国人"] },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "evidence": { "$ref": "#/$defs/evidence_list" }
      }
    },
    "chinese_identity_in_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "operator", "value", "description", "evidence"],
      "properties": {
        "field": { "const": "chinese_identity" },
        "operator": { "const": "in" },
        "value": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["国内华人", "海外华人", "外国人"] }
        },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "evidence": { "$ref": "#/$defs/evidence_list" }
      }
    },
    "country_eq_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "operator", "value", "description", "evidence"],
      "properties": {
        "field": { "const": "country" },
        "operator": { "const": "eq" },
        "value": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "evidence": { "$ref": "#/$defs/evidence_list" }
      }
    },
    "country_in_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "operator", "value", "description", "evidence"],
      "properties": {
        "field": { "const": "country" },
        "operator": { "const": "in" },
        "value": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "evidence": { "$ref": "#/$defs/evidence_list" }
      }
    },
    "affiliation_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "operator", "value", "description", "evidence"],
      "properties": {
        "field": { "const": "current_affiliation" },
        "operator": { "enum": ["match", "match_phrase"] },
        "value": { "type": "string", "minLength": 1, "maxLength": 500 },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "evidence": { "$ref": "#/$defs/evidence_list" }
      }
    },
    "executable_condition": {
      "oneOf": [
        { "$ref": "#/$defs/numeric_threshold_condition" },
        { "$ref": "#/$defs/numeric_between_condition" },
        { "$ref": "#/$defs/chinese_identity_eq_condition" },
        { "$ref": "#/$defs/chinese_identity_in_condition" },
        { "$ref": "#/$defs/country_eq_condition" },
        { "$ref": "#/$defs/country_in_condition" },
        { "$ref": "#/$defs/affiliation_condition" }
      ]
    },
    "unsupported_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "evidence"],
      "properties": {
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "evidence": { "$ref": "#/$defs/evidence_list" }
      }
    },
    "source_conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "evidence"],
      "properties": {
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "evidence": {
          "type": "array",
          "minItems": 2,
          "maxItems": 20,
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    }
  }
}
