RN_DATABASE_URL=postgresql+asyncpg://relationship:replace-with-local-postgres-password@127.0.0.1:15432/relationship_network
RN_REDIS_URL=redis://127.0.0.1:16379/0
RN_OBJECT_STORAGE_ENDPOINT=127.0.0.1:9000
RN_OBJECT_STORAGE_ACCESS_KEY=replace-with-local-minio-user
RN_OBJECT_STORAGE_SECRET_KEY=replace-with-local-minio-password
RN_OBJECT_STORAGE_BUCKET=relationship-network
RN_OBJECT_STORAGE_SECURE=false
RN_SESSION_TTL_SECONDS=1209600
RN_SESSION_RENEWAL_WINDOW_SECONDS=86400
RN_SESSION_COOKIE_SECURE=false
RN_INVITATION_TTL_SECONDS=604800
RN_MFA_CHALLENGE_TTL_SECONDS=300
RN_APP_BASE_URL=http://localhost:3000
RN_SMTP_HOST=
RN_SMTP_PORT=587
RN_SMTP_USERNAME=
RN_SMTP_PASSWORD=
RN_SMTP_FROM=no-reply@relationship-network.local
RN_SMTP_USE_TLS=true

# Host-side backend talks to the Compose fake OpenRouter published on 18080.
# Use https://openrouter.ai/api/v1 and a real key only for a live capability probe.
RN_OPENROUTER_API_KEY=fake-openrouter-key
RN_OPENROUTER_BASE_URL=http://127.0.0.1:18080/api/v1
RN_OPENROUTER_SITE_URL=http://localhost:3000
RN_OPENROUTER_SITE_NAME=Relationship Network

# Host-side backend talks to the Compose fake search base published on 18081.
# Use a real search-base URL and service key only outside CI.
RN_SEARCH_BASE_API_KEY=fake-search-base-key
RN_SEARCH_BASE_BASE_URL=http://127.0.0.1:18081
RN_SEARCH_BASE_TIMEOUT_SECONDS=10
RN_SEARCH_BASE_CONTRACT_VERSION=v1

# Natural-language search run technical rate limiting.
RN_SEARCH_RUN_CREATION_LIMIT_PER_HOUR=20

# JSON key ring. Each value must be a Base64-encoded 32-byte AES-256 key.
RN_LLM_RAW_RESPONSE_KEYS={"local-v1":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="}
RN_LLM_RAW_RESPONSE_ACTIVE_KEY_ID=local-v1

# Comma-separated emails promoted to platform admin on registration/login
RN_PLATFORM_ADMIN_EMAILS=llm-e2e-admin-chrome@example.com,llm-e2e-admin-edge@example.com
